<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121729"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PDF Nova Studio"
            android:textColor="#37D3E8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRO"
            android:textColor="#7C5CFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <Button
            android:id="@+id/btn_w4_merge"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📄 Merge"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:background="#1C243B"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_w4_split"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="✂️ Split"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:background="#1C243B"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_w4_compress"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🗜️ Compress"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:background="#1C243B" />

    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_w4_scan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📷 Scan"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:background="#1C243B"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_w4_notes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📝 Notes"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:background="#1C243B"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_w4_word"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📘 Word"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:background="#1C243B" />

    </LinearLayout>
</LinearLayout>
